{
  "manifest_version": 3,
  "name": "WorkTime Page Context",
  "version": "0.2.0",
  "description": "Sends the active page title/URL/visible text to the local WorkTime collector on 127.0.0.1 only.",
  "permissions": ["storage", "tabs", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "WorkTime",
    "default_popup": "popup.html"
  },
  "minimum_chrome_version": "102"
}
